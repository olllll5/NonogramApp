<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NonogramApp.Pages.GamePage"
             Title="Нонограмма">

    <AbsoluteLayout>
        <Grid RowDefinitions="Auto, *, Auto" Padding="10"
              AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">

            <Grid ColumnDefinitions="*, *" Grid.Row="0" Margin="0,0,0,10">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Ошибки:" VerticalOptions="Center"/>
                    <Label x:Name="ErrorsLabel" Text="0/5" TextColor="Red" FontAttributes="Bold" FontSize="18"/>
                </HorizontalStackLayout>
                <Label x:Name="LayerInfoLabel" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1" Orientation="Both">
                <Grid x:Name="GameGrid" HorizontalOptions="Center" VerticalOptions="Center" 
                      BackgroundColor="LightGray" ColumnSpacing="1" RowSpacing="1" />
            </ScrollView>

            <Button Grid.Row="2" Text="ПРОВЕРИТЬ СЛОЙ" BackgroundColor="Green" Clicked="OnCheckResultClicked" Margin="0,10,0,0"/>
        </Grid>

        <StackLayout AbsoluteLayout.LayoutBounds="0.98, 0.20, -1, -1" AbsoluteLayout.LayoutFlags="PositionProportional" Spacing="10">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                <Button x:Name="EyeButton" Text="👁" WidthRequest="50" HeightRequest="50" CornerRadius="25" 
                        IsVisible="False" BackgroundColor="White" TextColor="Black" Clicked="OnToggleEyeClicked"/>

                <Button Text="≡" WidthRequest="60" HeightRequest="60" CornerRadius="30" FontSize="25"
                        BackgroundColor="DeepSkyBlue" TextColor="White" Clicked="OnMenuClicked"/>
            </HorizontalStackLayout>
        </StackLayout>
    </AbsoluteLayout>
</ContentPage>
