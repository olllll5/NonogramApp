<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NonogramApp.Pages.MainPage">

    <Grid RowDefinitions="Auto, *" Padding="20">
        <ImageButton Source="avatar_placeholder.png"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     WidthRequest="50" HeightRequest="50"
                     CornerRadius="25"
                     Clicked="OnAvatarClicked" />

        <VerticalStackLayout Grid.Row="1" Spacing="15" VerticalOptions="Center">
            <Label Text="NONOGRAM LAYERS" FontSize="32" HorizontalOptions="Center" Margin="0,0,0,40"/>

            <Button Text="ИГРАТЬ" Clicked="OnPlayClicked" WidthRequest="200"/>
            <Button Text="ВЫХОД" Clicked="OnExitClicked" WidthRequest="200" BackgroundColor="IndianRed"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
